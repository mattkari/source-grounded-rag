# Copy to .env and fill in. NEVER commit the filled-in file — .env is gitignored.
# On the Pi:  cp .env.example .env && chmod 600 .env
#
# IMPORTANT: Docker's env_file parser does not strip trailing comments. Everything
# after the "=" becomes the value, "# like this" included. Keep every comment on
# its own line, and put nothing after a value.

# --- credentials -------------------------------------------------------------
# Two independent model roles, both required for every question. Anthropic has
# no embeddings endpoint, so the embedding role necessarily uses a different
# vendor — a real constraint, not an oversight.

# Embedding role: embeds the question so it can be matched against the index.
OPENAI_API_KEY=

# Generation role: writes the grounded answer.
ANTHROPIC_API_KEY=

# --- model roles -------------------------------------------------------------
# Leave commented out to use the defaults in config.py. The index records which
# embedding model built it and the app refuses to query an index built with a
# different one, so changing this means re-running ingest.py.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=

# --- where the service listens ON THE HOST -----------------------------------
# The Pi's side of the port mapping, not the container's.
#
#   127.0.0.1  loopback only (default). Reach it with an SSH tunnel —
#                ssh -L 8501:127.0.0.1:8501 pi@raspberrypi
#              — or over Tailscale. Nothing is exposed to your LAN.
#   0.0.0.0    reachable from any device on your LAN. Convenient, and it means
#              anyone on the network can spend your API budget.
#
# Do not port-forward this to the internet without authentication in front of
# it — see docs/deployment/raspberry-pi.md.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8501

# --- host settings -----------------------------------------------------------
TZ=Europe/London
