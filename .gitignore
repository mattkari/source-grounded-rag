.env
.env.*
!.env.example
.venv/
# Run records hold answer text and stay local. The evaluation summary
# (runs/eval_<timestamp>.md) is ids, page labels and counts only, and is
# committed after a recorded run (PLAN_V3 §7).
runs/*
!runs/eval_*.md
# Uploaded theses (PLAN_V4): other people's work. Never committed.
library/
__pycache__/
*.pyc

# Drafted articles (PLAN_V6): researcher-reviewed output, kept local.
output/
# Footnote maps (PLAN_V6 §7): chunk ids and character offsets, no text. The
# built-in thesis's map is committed; maps of uploaded theses are rebuilt locally.
footnote_maps/*
!footnote_maps/karimov-2017-quranic-justice.json
