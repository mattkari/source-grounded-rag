.env
.env.*
!.env.example
.venv/
# Run records hold answer text and stay local. The evaluation summary
# (runs/eval_<timestamp>.md) is ids, page labels and counts only, and is
# committed after a recorded run (PLAN_V3 §7).
runs/*
!runs/eval_*.md
# Uploaded theses (PLAN_V4): other people's work. Never committed.
library/
__pycache__/
*.pyc
